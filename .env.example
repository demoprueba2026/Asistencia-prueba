# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA DE ASISTENCIA Y GESTIÓN ESCOLAR
# Copia este archivo como .env para desarrollo local o agrégalas en Vercel
# (Vercel -> Project Settings -> Environment Variables)
# ==============================================================================

# Supabase (Obligatorio)
# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave anon/public o service_role de Supabase
SUPABASE_KEY=tu_clave_anon_o_service_role_de_supabase

# Puerto para desarrollo local con Express (opcional, por defecto 3000)
PORT=3000

# Gmail (Opcional - solo si deseas enviar resúmenes diarios de asistencia por correo)
# Correo de Gmail desde el cual se enviarán los resúmenes
GMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicación generada en la cuenta de Google (no tu clave habitual)
# https://myaccount.google.com/apppasswords
GMAIL_PASS=tu_contraseña_de_aplicacion_google

# Nombre o correo de remitente (opcional)
EMAIL_FROM=tu_correo@gmail.com

# WhatsApp Business API (Opcional - solo si usas Cloud API de Meta)
WABA_PHONE_NUMBER_ID=
WABA_TOKEN=

